# Salin file ini menjadi ".env" lalu isi dengan API key Groq milikmu.
# Dapatkan key gratis di: https://console.groq.com/keys
GROQ_API_KEY=isi_dengan_api_key_groq_kamu_di_sini

# Opsional — model Groq yang dipakai (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Opsional — port server Flask (default: 5000)
PORT=5000
